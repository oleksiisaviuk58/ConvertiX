@model ConvertiX.ConvertViewModel

<title>ConvertiX</title>
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

<div class="block">
    <form asp-action="Index" method="post">
        <h1>Конвертер валют</h1>
        <p>Введіть суму та виберіть напрямок конвертації</p>
        
        <input asp-for="Amount" class="amount_input" type="text" placeholder="Сума">
        <span asp-validation-for="Amount"></span>
        
        <vc:currencies name="From" selected-value="@Model?.From?.ToString()" />
        <span asp-validation-for="From"></span>
        
        <vc:currencies name="To" selected-value="@Model?.To?.ToString()" />
        <span asp-validation-for="To"></span>

        <div class="result">
            <p>Результат:</p>
            <input asp-for="Result" class="result_input" type="text" readonly placeholder="Тут буде результат">
        </div>

        <div class="actions">
            <button type="submit" class="send_button">Конвертувати</button>
            <button type="reset" class="reset_button">Скинути</button>
        </div>
    </form>
</div>

<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.5.1.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.17.0/jquery.validate.min.js"></script>
<script src="https://ajax.aspnetcdn.com/ajax/jquery.validation.unobtrusive/3.2.10/jquery.validate.unobtrusive.min.js"></script>