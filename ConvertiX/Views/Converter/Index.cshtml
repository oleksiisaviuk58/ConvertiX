@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<title>ConvertiX</title>
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

<div class="block">
    <form asp-action="convert" method="post">
        <h1>Конвертер валют</h1>
        <p>Введіть суму та виберіть напрямок конвертації</p>
        
        <input name="amount" class="amount_input" type="number" placeholder="Сума" min="0" step="0.01">
        <input name="from" class="from_input" type="text" placeholder="З якої валюти">
        <input name="to" class="to_input" type="text" placeholder="В яку валюту">

        <div class="result">
            <p>Результат:</p>
            <input class="result_input" type="text" readonly placeholder="Тут буде результат">
        </div>

        <div class="actions">
            <button type="submit" class="send_button">Конвертувати</button>
            <button type="reset" class="reset_button">Скинути</button>
        </div>
    </form>
</div>