@model ConvertiX.Currency

<title>ConvertiX</title>
<link rel="stylesheet" href="~/css/style.css" asp-append-version="true">

<div class="block">
    <form asp-action="Index" method="post">
        <h1>Конвертер валют</h1>
        <p>Введіть суму та виберіть напрямок конвертації</p>
        
        <input name="amount" class="amount_input" type="text" placeholder="Сума">
        
        @await Component.InvokeAsync("Currencies", new { name="fromId" })
        
        <vc:currencies name="toId"/>

        <div class="result">
            <p>Результат:</p>
            <input class="result_input" type="text" readonly placeholder="Тут буде результат" 
                   value="@(ViewBag?.Result ?? "")">
        </div>

        <div class="actions">
            <button type="submit" class="send_button">Конвертувати</button>
            <button type="reset" class="reset_button">Скинути</button>
        </div>
    </form>
</div>